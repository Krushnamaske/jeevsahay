# Anthropic API key, used by the PawConnect AI chatbot (/chat endpoint)
ANTHROPIC_API_KEY=your_api_key_here

# Server port
PORT=3000

# MongoDB connection string
# Local example: mongodb://127.0.0.1:27017/jeevsahay
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jeevsahay
MONGO_URI=mongodb://127.0.0.1:27017/jeevsahay

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Set to "production" when deploying (enables secure cookies, hides stack traces)
NODE_ENV=development

# Optional: Google Maps API key for the Directory module (Phase 2)
GOOGLE_MAPS_API_KEY=your_google_maps_key_here
